{
  "name": "flashback-naija",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && prisma db seed && next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "data:import": "tsx scripts/import-questions.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "prisma": "6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": { "node": ">=20" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
