generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
  REVIEWER
}

enum QuestionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  FLAGGED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  IMAGE
  AUDIO
  LOGO
  FINISH_IT
  TIMELINE
  GUESS_PERSON
  GUESS_YEAR
  PRICE_MEMORY
}

enum GameMode {
  QUICK
  YEAR
  DECADE
  CATEGORY
  MULTIPLAYER
}

enum GameStatus {
  ACTIVE
  COMPLETE
  ABANDONED
}

enum RoomStatus {
  WAITING
  ACTIVE
  COMPLETE
  EXPIRED
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  passwordHash String
  role Role @default(PLAYER)
  presenter String @default("LAGOS_HYPE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  games Game[]
  answers PlayerAnswer[]
  history QuestionHistory[]
  hostedRooms Room[] @relation("RoomHost")
  joinedRooms Room[] @relation("RoomGuest")
  stats UserStats?
  challenges Challenge[]
  challengeAttempts ChallengeAttempt[]
  memoryCapsules MemoryCapsule[]
  capsuleAttempts CapsuleAttempt[]
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Question {
  id String @id @default(cuid())
  externalId String? @unique
  question String
  year Int
  category String
  subcategory String
  difficulty Difficulty
  questionType QuestionType @default(MULTIPLE_CHOICE)
  options String[]
  correctAnswer String
  explanation String
  source String
  imageUrl String?
  audioUrl String?
  status QuestionStatus @default(DRAFT)
  verified Boolean @default(false)
  fingerprint String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  answers PlayerAnswer[]
  history QuestionHistory[]
  gameQuestions GameQuestion[]
  roomQuestions RoomQuestion[]
  challengeQuestions ChallengeQuestion[]
  @@index([status, verified, year])
  @@index([status, verified, category])
  @@index([difficulty, questionType])
}

model Game {
  id String @id @default(cuid())
  userId String?
  mode GameMode
  filterYear Int?
  filterDecade Int?
  filterCategory String?
  presenter String @default("LAGOS_HYPE")
  participantName String?
  challengerKey String?
  challengeId String?
  status GameStatus @default(ACTIVE)
  accessTokenHash String
  currentIndex Int @default(0)
  score Int @default(0)
  correctCount Int @default(0)
  categoryBreakdown Json @default("{}")
  nostalgiaScore Int @default(0)
  startedAt DateTime @default(now())
  completedAt DateTime?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  questions GameQuestion[]
  answers PlayerAnswer[]
  challenge Challenge? @relation("ChallengeGames", fields: [challengeId], references: [id], onDelete: SetNull)
  createdChallenge Challenge? @relation("OriginalGame")
  challengeAttempt ChallengeAttempt?
  @@index([userId, startedAt])
  @@index([completedAt, score])
}

model Challenge {
  id String @id @default(cuid())
  code String @unique
  creatorId String?
  originalGameId String @unique
  creatorName String
  creatorScore Int
  creatorNostalgia Int
  bestOf Int @default(3)
  createdAt DateTime @default(now())
  expiresAt DateTime
  creator User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  originalGame Game @relation("OriginalGame", fields: [originalGameId], references: [id], onDelete: Cascade)
  games Game[] @relation("ChallengeGames")
  questions ChallengeQuestion[]
  attempts ChallengeAttempt[]
  @@index([creatorId, createdAt])
  @@index([expiresAt])
}

model ChallengeQuestion {
  challengeId String
  questionId String
  position Int
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  @@id([challengeId, questionId])
  @@unique([challengeId, position])
}

model ChallengeAttempt {
  id String @id @default(cuid())
  challengeId String
  gameId String @unique
  userId String?
  challengerKey String
  playerName String
  score Int
  correct Int
  nostalgia Int
  createdAt DateTime @default(now())
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([challengeId, score])
  @@index([challengeId, challengerKey])
}

model MemoryCapsule {
  id String @id @default(cuid())
  code String @unique
  ownerId String
  title String
  format String
  place String
  yearStart Int
  yearEnd Int?
  description String
  coverEmoji String @default("📼")
  status String @default("UNLISTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions CapsuleQuestion[]
  attempts CapsuleAttempt[]
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
}

model CapsuleQuestion {
  id String @id @default(cuid())
  capsuleId String
  position Int
  prompt String
  options String[]
  correctAnswer String
  revealStory String
  memoryYear Int?
  mediaUrl String?
  capsule MemoryCapsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  @@unique([capsuleId, position])
}

model CapsuleAttempt {
  id String @id @default(cuid())
  capsuleId String
  userId String?
  playerName String
  relationship String?
  playerKey String
  accessTokenHash String
  currentIndex Int @default(0)
  score Int @default(0)
  correct Int @default(0)
  status String @default("ACTIVE")
  memoryNote String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  capsule MemoryCapsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([capsuleId, score])
  @@index([capsuleId, playerKey])
}

model GameQuestion {
  gameId String
  questionId String
  position Int
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  @@id([gameId, questionId])
  @@unique([gameId, position])
}

model PlayerAnswer {
  id String @id @default(cuid())
  gameId String?
  roomId String?
  userId String
  questionId String
  answer String?
  correct Boolean
  points Int
  responseMs Int
  createdAt DateTime @default(now())
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  @@unique([gameId, userId, questionId])
  @@unique([roomId, userId, questionId])
}

model QuestionHistory {
  userId String
  questionId String
  seenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@id([userId, questionId])
  @@index([userId, seenAt])
}

model UserStats {
  userId String @id
  totalScore Int @default(0)
  weeklyScore Int @default(0)
  gamesPlayed Int @default(0)
  correctAnswers Int @default(0)
  currentStreak Int @default(0)
  bestStreak Int @default(0)
  categoryScores Json @default("{}")
  yearScores Json @default("{}")
  weekStartedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id String @id @default(cuid())
  code String @unique
  hostId String
  guestId String?
  status RoomStatus @default(WAITING)
  mode GameMode @default(MULTIPLAYER)
  hostIndex Int @default(0)
  guestIndex Int @default(0)
  hostScore Int @default(0)
  guestScore Int @default(0)
  createdAt DateTime @default(now())
  startedAt DateTime?
  expiresAt DateTime
  completedAt DateTime?
  host User @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest User? @relation("RoomGuest", fields: [guestId], references: [id], onDelete: SetNull)
  questions RoomQuestion[]
  answers PlayerAnswer[]
  @@index([status, expiresAt])
}

model RoomQuestion {
  roomId String
  questionId String
  position Int
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  @@id([roomId, questionId])
  @@unique([roomId, position])
}
